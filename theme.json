{
  "name": "docs",
  "displayName": "Documentation",
  "description": "Technical documentation with sidebar navigation",
  "version": "1.0.0",
  "pages": [
    {
      "name": "index",
      "path": "/",
      "file": "index.html"
    },
    {
      "name": "page",
      "path": "/docs/:slug",
      "file": "page.html"
    }
  ],
  "configSchema": {
    "accentColor": {
      "type": "string",
      "default": "#3b82f6",
      "description": "Primary accent color for links and highlights"
    },
    "showSearch": {
      "type": "boolean",
      "default": true,
      "description": "Show search input in header"
    },
    "sidebarPosition": {
      "type": "string",
      "enum": ["left", "right"],
      "default": "left",
      "description": "Position of the sidebar navigation"
    }
  },
  "assets": ["assets/style.css"]
}
